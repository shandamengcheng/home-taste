.family-hero{position:relative;overflow:hidden;text-align:center;padding:44rpx 0 26rpx;border-radius:0 0 32rpx 32rpx}.family-hero-covered{min-height:300rpx;padding:0;display:flex;align-items:flex-end;color:#fff}.family-cover{position:absolute;inset:0;width:100%;height:100%;z-index:0}.family-hero-covered::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(26,24,18,.08),rgba(26,24,18,.62));z-index:1}.family-hero-content{position:relative;z-index:2;width:100%}.family-hero-covered .family-hero-content{padding:42rpx 28rpx 32rpx;box-sizing:border-box}.family-hero-covered .hero-sub{color:rgba(255,255,255,.88)}.home{font-size:100rpx;margin-bottom:18rpx}.profile-shortcuts{display:flex;gap:16rpx;margin:22rpx 0}.profile-shortcut{flex:1;min-width:0;background:#fff;border-radius:24rpx;padding:20rpx;display:flex;align-items:center;gap:14rpx;box-shadow:0 8rpx 24rpx rgba(62,51,34,.05);font-size:26rpx;font-weight:700}.profile-shortcut>text:first-child{font-size:36rpx}.profile-shortcut .muted{font-size:22rpx;font-weight:400;margin-top:4rpx}.chevron{margin-left:auto;color:#bbb8ae;font-size:40rpx;font-weight:400}.invite{text-align:center}.code{font-size:68rpx;font-weight:900;letter-spacing:16rpx;color:#e05d3f;margin:24rpx 0}.invite .btn{margin-top:28rpx}.text-btn{height:64rpx;min-height:64rpx;margin:12rpx auto 0;padding:0 20rpx;display:flex;align-items:center;justify-content:center;background:transparent;color:#8b8a80;font-size:25rpx;line-height:1}.text-btn::after{border:0}.member{display:flex;align-items:center}.avatar{width:90rpx;height:90rpx;overflow:hidden;background:#f2eee5;border-radius:45rpx;display:flex;align-items:center;justify-content:center;font-size:42rpx;margin-right:22rpx}.avatar-image{width:100%;height:100%}.member-main{flex:1;min-width:0}.member-name{font-weight:800;font-size:31rpx;margin-bottom:8rpx}.edit-me{color:#e05d3f;font-size:25rpx;padding:12rpx}.actions{display:flex;align-items:center;gap:20rpx;color:#e05d3f;font-size:24rpx}.actions .danger{color:#b84632}.profile-mask{position:fixed;z-index:100;inset:0;background:rgba(37,37,31,.42);display:flex;align-items:flex-end}.profile-sheet{width:100%;box-sizing:border-box;background:#fffaf4;border-radius:32rpx 32rpx 0 0;padding:18rpx 28rpx calc(40rpx + env(safe-area-inset-bottom))}.sheet-handle{width:72rpx;height:8rpx;border-radius:8rpx;background:#dedbd3;margin:0 auto 24rpx}.sheet-title{font-size:36rpx;font-weight:800}.sheet-sub{color:#8b8a80;font-size:25rpx;margin:10rpx 0 24rpx}.sheet-label{font-size:27rpx;font-weight:700;margin:24rpx 0 12rpx}.upload-row{display:flex;align-items:center;gap:22rpx}.image-preview{overflow:hidden;background:#f2eee5;display:flex;align-items:center;justify-content:center;font-size:54rpx;flex:none}.image-preview image{width:100%;height:100%}.cover-preview{width:180rpx;height:110rpx;border-radius:20rpx}.portrait-preview{width:110rpx;height:110rpx;border-radius:55rpx}.upload-btn{height:58rpx;min-height:58rpx;line-height:58rpx;padding:0 20rpx;margin:0;background:#fff0e9;color:#e05d3f;border-radius:999rpx;font-size:24rpx;font-weight:700}.upload-btn::after{border:0}.remove-image{display:inline-block;color:#b84632;font-size:23rpx;margin:14rpx 0 0 8rpx}.upload-hint{color:#8b8a80;font-size:22rpx;margin-top:12rpx}.avatar-picker{display:flex;flex-wrap:wrap;gap:18rpx;margin-bottom:34rpx}.avatar-choice{width:76rpx;height:76rpx;box-sizing:border-box;border-radius:38rpx;background:#f2eee5;display:flex;align-items:center;justify-content:center;font-size:38rpx;border:4rpx solid transparent}.avatar-choice.selected{background:#fff0e9;border-color:#e05d3f}
