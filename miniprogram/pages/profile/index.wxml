<view class="page">
  <view class="family-hero {{family.coverImage?'family-hero-covered':''}}"><image wx:if="{{family.coverImage}}" class="family-cover" src="{{family.coverImage}}" mode="aspectFill"/><view class="family-hero-content"><view class="home">{{family.avatar||'🏡'}}</view><view class="hero-title">{{family.name||'我的家庭'}}</view><view class="hero-sub">家庭成员 {{members.length}} / {{family.maxMembers||5}}</view></view></view>
  <view class="profile-shortcuts"><view wx:if="{{isOwner}}" class="profile-shortcut" bindtap="openSettings" data-mode="family"><text>🏠</text><view><view>家庭资料</view><view class="muted">名称和头像</view></view><text class="chevron">›</text></view><view class="profile-shortcut" bindtap="openSettings" data-mode="me"><text>👤</text><view><view>我的资料</view><view class="muted">昵称和头像</view></view><text class="chevron">›</text></view></view>
  <view class="card invite"><view class="muted">家庭邀请码</view><view class="code">{{family.inviteCode||'------'}}</view><view class="muted">家人打开小程序后，输入邀请码即可加入</view><button class="btn btn-secondary" bindtap="copyCode">复制邀请码</button><button wx:if="{{isOwner}}" class="text-btn" bindtap="refreshCode">刷新邀请码</button></view>
  <view class="section-title">家庭成员</view>
  <view class="card member" wx:for="{{members}}" wx:key="_id"><view class="avatar"><image wx:if="{{item.avatarImage}}" class="avatar-image" src="{{item.avatarImage}}" mode="aspectFill"/><text wx:else>{{item.avatar||(item.role==='owner'?'👑':'🧑‍🍳')}}</text></view><view class="member-main"><view class="member-name">{{item.displayName||('家庭成员 '+(index+1))}}</view><view class="muted">{{item._openid===openid?'这是你':(item.role==='owner'?'家庭管理员':'家庭成员')}}</view></view><text wx:if="{{item._openid===openid}}" class="edit-me" bindtap="openSettings" data-mode="me">编辑</text><view wx:if="{{isOwner&&item._openid!==openid}}" class="actions"><text catchtap="transferOwner" data-id="{{item._id}}">转让</text><text class="danger" catchtap="removeMember" data-id="{{item._id}}">移除</text></view></view>
  <button class="btn btn-ghost" bindtap="leave">退出当前家庭</button>
  <view wx:if="{{editingMode}}" class="profile-mask" catchtap="closeSettings"><view class="profile-sheet" catchtap="stopTap"><view class="sheet-handle"></view><view class="sheet-title">{{editingMode==='family'?'编辑家庭资料':'编辑我的资料'}}</view><view class="sheet-sub">{{editingMode==='family'?'这份资料会展示给所有家庭成员':'只有你可以修改自己的资料'}}</view><view class="sheet-label">{{editingMode==='family'?'家庭名称':'我的昵称'}}</view><input class="input" value="{{draftName}}" maxlength="{{draftNameMax}}" bindinput="onDraftName" placeholder="请输入名称"/><view class="sheet-label">{{editingMode==='family'?'家庭封面':'个人头像'}}</view><view class="upload-row"><view class="image-preview {{editingMode==='family'?'cover-preview':'portrait-preview'}}"><image wx:if="{{draftImage}}" src="{{draftImage}}" mode="aspectFill"/><text wx:else>{{draftAvatar}}</text></view><view><button class="upload-btn" bindtap="chooseImage">从相册选择</button><text wx:if="{{draftImage}}" class="remove-image" bindtap="removeImage">移除图片</text><view class="upload-hint">JPG、PNG，最大 5MB</view></view></view><view class="sheet-label">{{editingMode==='family'?'封面图标':'备用头像'}}</view><view class="avatar-picker"><view wx:for="{{avatarOptions}}" wx:key="*this" class="avatar-choice {{draftAvatar===item?'selected':''}}" bindtap="chooseAvatar" data-avatar="{{item}}">{{item}}</view></view><button class="btn btn-primary" bindtap="saveSettings" loading="{{saving}}" disabled="{{saving}}">保存资料</button></view></view>
</view>
