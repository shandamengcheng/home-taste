<view class="page">
  <view class="family-hero"><view class="home">🏡</view><view class="hero-title">{{family.name || '我的家庭'}}</view><view class="hero-sub">两个人的小厨房</view></view>
  <view class="card invite"><view class="muted">家庭邀请码</view><view class="code">{{family.inviteCode || '------'}}</view><view class="muted">让另一半打开小程序，输入此邀请码加入</view><button class="btn btn-secondary" bindtap="copyCode">复制邀请码</button></view>
  <view class="section-title">家庭成员</view>
  <view class="card member" wx:for="{{members}}" wx:key="_id"><view class="avatar">{{index === 0 ? '👩‍🍳' : '🧑‍🍳'}}</view><view><view class="member-name">{{item.displayName || ('家庭成员 ' + (index + 1))}}</view><view class="muted">{{item._openid === openid ? '这是你' : '已加入家庭'}}</view></view></view>
  <button class="btn btn-ghost" bindtap="leave">退出当前家庭</button>
</view>
