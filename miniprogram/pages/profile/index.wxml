<view class="page">
  <view class="family-hero"><view class="home">🏡</view><view class="hero-title">{{family.name||'我的家庭'}}</view><view class="hero-sub">家庭成员 {{members.length}} / {{family.maxMembers||5}}</view></view>
  <view class="card invite"><view class="muted">家庭邀请码</view><view class="code">{{family.inviteCode||'------'}}</view><view class="muted">家人打开小程序后，输入邀请码即可加入</view><button class="btn btn-secondary" bindtap="copyCode">复制邀请码</button><button wx:if="{{isOwner}}" class="text-btn" bindtap="refreshCode">刷新邀请码</button></view>
  <view class="section-title">家庭成员</view>
  <view class="card member" wx:for="{{members}}" wx:key="_id"><view class="avatar">{{item.role==='owner'?'👑':'🧑‍🍳'}}</view><view class="member-main"><view class="member-name">{{item.displayName||('家庭成员 '+(index+1))}}</view><view class="muted">{{item._openid===openid?'这是你':(item.role==='owner'?'家庭管理员':'家庭成员')}}</view></view><view wx:if="{{isOwner&&item._openid!==openid}}" class="actions"><text catchtap="transferOwner" data-id="{{item._id}}">转让</text><text class="danger" catchtap="removeMember" data-id="{{item._id}}">移除</text></view></view>
  <button class="btn btn-ghost" bindtap="leave">退出当前家庭</button>
</view>
