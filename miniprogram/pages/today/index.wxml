<view class="page">
  <view class="hero"><view class="eyebrow">{{family.name}}</view><view class="hero-title">{{friendlyDate}}</view><view class="hero-sub">家人的选择会自动汇总为今日菜单</view></view>
  <picker mode="date" value="{{date}}" bindchange="changeDate"><view class="date-picker">📅 {{friendlyDate}}<text>切换</text></view></picker>

  <view class="section-head"><view><view class="section-title compact">今日菜单</view><view wx:if="{{voteDishes.length}}" class="muted auto-hint">已自动同步 · 共 {{voteDishes.length}} 道菜</view></view><view wx:if="{{voteDishes.length}}" class="auto-status">自动汇总</view></view>
  <view wx:if="{{!voteDishes.length}}" class="empty card"><view class="empty-icon">🍽️</view><view>今天还没有人点菜</view><view class="muted empty-hint">选好后会直接成为今日菜单</view><button class="btn btn-primary mini-btn" bindtap="goSelect">我来点菜</button></view>
  <view class="menu-dish card" wx:for="{{voteDishes}}" wx:key="index">
    <view class="cover" style="background:{{item.dish.color}}">{{item.dish.emoji}}</view>
    <view class="dish-main"><view class="dish-name">{{item.dish.name}}</view><view class="muted voter">{{item.voterSummary}} 想吃</view></view>
    <view class="votes">{{item.count}}票</view>
  </view>
  <view wx:if="{{voteDishes.length}}" class="actions"><button class="btn btn-primary" bindtap="goSelect">修改我的选择</button><button class="btn btn-secondary" bindtap="goShopping">查看采购清单</button></view>

  <view wx:if="{{!voteDishes.length && recommendations.length}}"><view class="section-title">可以试试</view><scroll-view class="recommend-scroll" scroll-x><view class="recommend-row"><view class="recommend" wx:for="{{recommendations}}" wx:key="_id"><view class="recommend-cover" style="background:{{item.color}}">{{item.emoji}}</view><view>{{item.name}}</view></view></view></scroll-view></view>
</view>
