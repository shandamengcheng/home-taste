.recipe-hero{min-height:220rpx;border-radius:30rpx;padding:32rpx;box-sizing:border-box;display:flex;align-items:center;gap:24rpx;margin:12rpx 0 24rpx}.recipe-emoji{width:126rpx;height:126rpx;border-radius:26rpx;background:rgba(255,255,255,.48);display:flex;align-items:center;justify-content:center;font-size:72rpx;flex:none}.recipe-copy{min-width:0}.recipe-name{font-size:44rpx;font-weight:800;line-height:1.2}.recipe-meta{font-size:25rpx;color:#645d51;margin-top:14rpx}.compact{margin:0 0 18rpx}.ingredient-summary{color:#858277;font-size:25rpx;line-height:1.6;margin-bottom:18rpx}.ingredient-row{display:flex;justify-content:space-between;padding:18rpx 0;border-top:1rpx solid #f0eee9;color:#555249}.ingredient-row text:last-child{color:#8b887f}.step{display:flex;gap:18rpx;padding:20rpx 0;border-top:1rpx solid #f0eee9;line-height:1.65}.step-index{width:42rpx;height:42rpx;border-radius:21rpx;background:#fff0e9;color:#e05d3f;display:flex;align-items:center;justify-content:center;font-weight:800;flex:none}.note{line-height:1.65}.bottom-bar{position:fixed;z-index:5;bottom:0;left:0;right:0;padding:18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));background:rgba(255,255,255,.97);display:flex;gap:16rpx;box-shadow:0 -8rpx 30rpx rgba(0,0,0,.05)}.bottom-bar .btn{flex:1;margin:0}
