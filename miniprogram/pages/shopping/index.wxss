.date-picker{background:#edeae2;border-radius:18rpx;padding:22rpx 26rpx;margin-bottom:24rpx;display:flex;justify-content:space-between}.date-picker text{color:#e05d3f}.progress{padding:26rpx}.progress-head{display:flex;align-items:center;justify-content:space-between}.progress-title{font-size:31rpx;font-weight:800}.progress-count{font-size:23rpx;margin-top:6rpx}.select-all{height:60rpx;line-height:60rpx;margin:0;padding:0 24rpx;border-radius:99rpx;background:#edf5ed;color:#4f8058;font-size:24rpx;font-weight:700}.select-all::after{border:0}.progress .track{height:14rpx;background:#eeeae2;border-radius:10rpx;margin-top:22rpx;overflow:hidden}.bar{height:100%;background:#72a878;border-radius:10rpx;transition:width .2s ease}.shopping{display:flex;align-items:center;padding:24rpx 26rpx;margin-bottom:16rpx}.checkbox{width:52rpx;height:52rpx;border:3rpx solid #cfccc2;border-radius:14rpx;text-align:center;line-height:52rpx;color:#fff;flex:none}.item-body{padding-left:22rpx;min-width:0}.item-name{font-size:31rpx;font-weight:700;margin-bottom:8rpx}.item-body .muted{font-size:24rpx;line-height:1.5}.done{background:#fafbf8}.done .checkbox{background:#72a878;border-color:#72a878}.done .item-name{text-decoration:line-through;color:#aaa89f}
