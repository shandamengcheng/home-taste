<view class="page">
  <view class="hero"><view class="hero-title">{{friendlyDate}}</view><view class="hero-sub">想吃什么就勾上，另一半会同步看到</view></view>
  <picker mode="date" value="{{date}}" bindchange="changeDate"><view class="date-picker">📅 选择其他日期 <text>›</text></view></picker>
  <view wx:if="{{!dishes.length}}" class="empty"><view class="empty-icon">🍽️</view><view>先去菜谱添加几道菜吧</view></view>
  <view class="choice card {{selectedMap[item._id] ? 'selected' : ''}}" wx:for="{{dishes}}" wx:key="_id" bindtap="toggle" data-id="{{item._id}}">
    <view class="dish-cover" style="background: {{item.color}}">{{item.emoji}}</view>
    <view class="choice-body"><view class="choice-name">{{item.name}}</view><view class="muted">{{item.ingredientSummary}}</view></view>
    <view class="check">{{selectedMap[item._id] ? '✓' : ''}}</view>
  </view>
  <view class="bottom-bar"><view><text class="count">{{selectedIds.length}}</text> 道菜</view><button class="btn btn-primary save" bindtap="save" loading="{{saving}}">保存今日菜单</button></view>
</view>
