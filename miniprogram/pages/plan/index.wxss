.date-picker { background: #edeae2; border-radius: 18rpx; padding: 22rpx 26rpx; margin-bottom: 24rpx; color: #5f5d55; display: flex; align-items: center; justify-content: space-between; }
.history-note{background:#fff0e9;color:#a85643;border-radius:16rpx;padding:18rpx 22rpx;margin:-8rpx 0 24rpx;font-size:24rpx;line-height:1.5}
.choice { display: flex; align-items: center; border: 4rpx solid transparent; padding: 18rpx; }
.choice.selected { border-color: #e05d3f; background: #fffaf7; }
.dish-cover { width: 112rpx; height: 112rpx; border-radius: 22rpx; display:flex; align-items:center; justify-content:center; font-size: 56rpx; }
.choice-body { flex:1; min-width:0; padding:0 22rpx; }.choice-name { font-size:32rpx; font-weight:800; margin-bottom:10rpx; }
.choice-body .muted { white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }.check { width: 48rpx; height:48rpx; border:3rpx solid #d2cfc5; border-radius:50%; color:#fff; display:flex; align-items:center; justify-content:center; line-height:1; }
.selected .check { background:#e05d3f; border-color:#e05d3f; }
.bottom-bar { position:fixed; bottom:110rpx; left:0; right:0; padding:18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom)); background:rgba(255,255,255,.96); display:flex; align-items:center; justify-content:space-between; box-shadow:0 -8rpx 30rpx rgba(0,0,0,.05); z-index:5; }
.bottom-bar .save { width:330rpx; margin:0; }.count { color:#e05d3f; font-weight:800; font-size:38rpx; }
