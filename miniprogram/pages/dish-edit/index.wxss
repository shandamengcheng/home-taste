.quick-start{margin-bottom:30rpx}.section-title.compact{margin:0 0 6rpx}.section-hint{font-size:24rpx}.template-scroll{white-space:nowrap;margin:20rpx -28rpx 0;padding-left:28rpx;box-sizing:border-box}.template-list{display:flex;gap:16rpx;padding-right:28rpx}.template-card{width:150rpx;background:#fff;border-radius:22rpx;padding:18rpx 14rpx;text-align:center;box-shadow:0 6rpx 22rpx rgba(62,51,34,.05);flex:none}.template-icon{font-size:52rpx}.template-name{font-size:25rpx;font-weight:800;margin:10rpx 0 5rpx;overflow:hidden;text-overflow:ellipsis}.template-category{font-size:21rpx;color:#99978e}
.preview{width:154rpx;height:154rpx;margin:6rpx auto 24rpx;border-radius:40rpx;display:flex;align-items:center;justify-content:center;font-size:78rpx}.choice-list{display:flex;flex-wrap:wrap;gap:12rpx}.choice-chip{padding:13rpx 22rpx;background:#efede7;border-radius:99rpx;color:#68665f;font-size:25rpx}.choice-chip.active{color:#fff;background:#e05d3f}.tag-choice.active{background:#edf5ed;color:#4f8058}
.emoji-list{display:flex;flex-wrap:wrap;gap:14rpx}.emoji{width:74rpx;height:74rpx;display:flex;align-items:center;justify-content:center;background:#fff;border-radius:18rpx;font-size:38rpx}.emoji.active{outline:4rpx solid #e05d3f}.field-hint{font-size:23rpx;color:#99978e;margin:-2rpx 0 14rpx}.quick-ingredients{display:flex;flex-wrap:wrap;gap:10rpx;margin-bottom:20rpx}.ingredient-chip{padding:11rpx 16rpx;background:#fff7f2;color:#bf5b43;border-radius:99rpx;font-size:23rpx}.ingredient-chip text{color:#999087;margin-left:4rpx}
.ingredient{display:flex;align-items:center;padding:18rpx 22rpx}.ingredient-name{width:42%}.ingredient-amount{flex:1;color:#7b796f}.remove{font-size:46rpx;color:#c3c0b7;padding:0 8rpx}.add{margin-top:10rpx}.optional-input{margin-top:16rpx}.optional{font-size:22rpx;color:#aaa89f;font-weight:400;margin-left:8rpx}.textarea{width:auto;min-height:120rpx}.save{margin-top:42rpx}.delete{margin-top:18rpx;color:#bc4832;background:transparent}
