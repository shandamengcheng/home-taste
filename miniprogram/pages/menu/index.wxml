<view class="page">
  <view class="hero">
    <view class="hero-title">家里的味道</view>
    <view class="hero-sub">{{dishes.length}} 道家常菜，点一下看看主要食材</view>
  </view>
  <view wx:if="{{!loading && !dishes.length}}" class="empty"><view class="empty-icon">🥢</view><view>还没有菜品，先添加一道拿手菜吧</view></view>
  <view class="dish card" wx:for="{{dishes}}" wx:key="_id" bindtap="editDish" data-id="{{item._id}}">
    <view class="dish-cover" style="background: {{item.color || '#f3d5b5'}}">{{item.emoji || '🍲'}}</view>
    <view class="dish-body">
      <view class="row between"><view class="dish-name">{{item.name}}</view><view class="arrow">›</view></view>
      <view class="muted ingredients">{{item.ingredientSummary || '暂未填写食材'}}</view>
      <view><text class="tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text></view>
    </view>
  </view>
  <view class="fab" bindtap="addDish">＋</view>
</view>
