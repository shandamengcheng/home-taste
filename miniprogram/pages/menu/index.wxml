<view class="page">
  <view class="hero"><view class="hero-title">家常菜谱</view><view class="hero-sub">从推荐中找灵感，也可以记录自家的味道</view></view>
  <view class="tabs"><view class="tab {{activeTab===item[0]?'active':''}}" wx:for="{{tabs}}" wx:key="0" bindtap="switchTab" data-tab="{{item[0]}}">{{item[1]}}</view></view>
  <scroll-view class="categories" scroll-x><view class="chips"><view class="chip {{category===item?'active':''}}" wx:for="{{categories}}" wx:key="*this" bindtap="pickCategory" data-value="{{item}}">{{item}}</view></view></scroll-view>
  <view wx:if="{{!loading && !displayDishes.length}}" class="empty"><view class="empty-icon">🥢</view><view>{{activeTab==='frequent'?'确认几次菜单后，这里会出现常点菜':'这个分类还没有菜品'}}</view></view>
  <view class="dish card" wx:for="{{displayDishes}}" wx:key="_id" bindtap="editDish" data-id="{{item._id}}" data-source="{{item.sourceType}}">
    <view class="dish-cover" style="background:{{item.color}}">{{item.emoji}}</view>
    <view class="dish-body">
      <view class="dish-head">
        <view class="dish-name">{{item.name}}</view>
        <view class="count" wx:if="{{item.selectedCount30d}}">近30天 {{item.selectedCount30d}} 次</view>
        <view wx:else class="dish-type">{{item.sourceType==='system'?'推荐菜':'自家菜'}}</view>
      </view>
      <view class="muted ingredients">{{item.ingredientSummary || '暂未填写食材'}}</view>
      <view class="dish-footer">
        <view class="tag-list"><text class="tag category-tag">{{item.category}}</text><text class="tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text></view>
        <button wx:if="{{item.sourceType==='system'}}" class="favorite" catchtap="favorite" data-id="{{item._id}}">＋ 收藏</button>
        <view wx:else class="edit-entry">编辑 <text>›</text></view>
      </view>
    </view>
  </view>
  <view wx:if="{{activeTab==='family'}}" class="fab" bindtap="addDish">＋</view>
</view>
