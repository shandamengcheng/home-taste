.tabs{display:flex;background:#ebe8e0;padding:8rpx;border-radius:22rpx;margin-bottom:22rpx}.tab{flex:1;text-align:center;padding:18rpx 0;border-radius:17rpx;font-weight:700;color:#77756c}.tab.active{background:#fff;color:#e05d3f;box-shadow:0 4rpx 14rpx rgba(0,0,0,.06)}
.categories{white-space:nowrap;margin:0 -28rpx 24rpx;padding:0 28rpx;box-sizing:border-box}.chips{display:flex;gap:12rpx;padding-right:28rpx}.chip{display:inline-block;padding:12rpx 22rpx;background:#efede7;border-radius:99rpx;color:#6e6c63;font-size:25rpx}.chip.active{background:#e05d3f;color:#fff}
.dish{display:flex;align-items:flex-start;padding:22rpx;margin-bottom:18rpx;border-radius:26rpx}.dish-cover{width:124rpx;height:124rpx;border-radius:22rpx;display:flex;align-items:center;justify-content:center;font-size:62rpx;flex:none}.dish-body{padding-left:22rpx;flex:1;min-width:0}.dish-head{display:flex;align-items:center;gap:12rpx;min-width:0}.dish-name{font-size:32rpx;line-height:1.25;font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;flex:1;min-width:0}.count,.dish-type{font-size:21rpx;line-height:36rpx;padding:0 12rpx;border-radius:99rpx;flex:none}.count{color:#e05d3f;background:#fff0e9}.dish-type{color:#8a887f;background:#f2f0ea}.ingredients{font-size:25rpx;margin:12rpx 0 14rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.dish-footer{display:flex;align-items:center;gap:14rpx;min-width:0}.tag-list{display:flex;gap:8rpx;overflow:hidden;white-space:nowrap;flex:1;min-width:0}.tag{font-size:21rpx;padding:6rpx 12rpx;margin:0;background:#f2f0ea;flex:none}.category-tag{color:#657665;background:#edf5ed}.favorite{height:54rpx;min-height:54rpx;margin:0;padding:0 20rpx;box-sizing:border-box;border-radius:99rpx;display:flex;align-items:center;justify-content:center;flex:none;background:#fff0e9;color:#e05d3f;font-size:23rpx;font-weight:700;line-height:1}.favorite::after{border:0}.edit-entry{font-size:23rpx;color:#99978e;flex:none}.edit-entry text{font-size:32rpx;margin-left:4rpx}
